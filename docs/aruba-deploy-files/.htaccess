# =============================================================================
#  .htaccess — ARIA Srl (produzione Aruba/Apache)
#  Caricare questo file nella RADICE del sito (webroot) via FTP.
#  NB: su GitHub Pages questo file è ignorato; serve solo in produzione.
# =============================================================================

# ----------------------------------------------------------------------------
#  1) Forma canonica del sito: HTTPS + www  (coerente con i tag <link canonical>)
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ==========================================================================
  #  Redirect 301: vecchi URL WordPress -> nuove pagine statiche .html
  #  (messi PRIMA del redirect canonico per fare un solo "salto".)
  #  Gestiscono sia con sia senza barra finale (/?$).
  # ==========================================================================
  # --- Pagine IT ---
  RewriteRule ^servizi/?$                       https://www.aria.srl/servizi.html [R=301,L]
  RewriteRule ^progetti/?$                       https://www.aria.srl/progetti.html [R=301,L]
  RewriteRule ^pubblicazioni/?$                  https://www.aria.srl/pubblicazioni.html [R=301,L]
  RewriteRule ^contatti/?$                       https://www.aria.srl/contatti.html [R=301,L]
  RewriteRule ^sicurezza-industriale/?$          https://www.aria.srl/sicurezza-industriale.html [R=301,L]
  RewriteRule ^ambienti-di-lavoro/?$             https://www.aria.srl/ambienti-di-lavoro.html [R=301,L]
  RewriteRule ^affidabilita-e-manutenibilita/?$  https://www.aria.srl/affidabilita-e-manutenibilita.html [R=301,L]
  RewriteRule ^sistemi-di-gestione/?$            https://www.aria.srl/sistemi-di-gestione.html [R=301,L]
  RewriteRule ^formazione-e-addestramento/?$     https://www.aria.srl/formazione-e-addestramento.html [R=301,L]
  RewriteRule ^fattori-umani/?$                  https://www.aria.srl/fattori-umani.html [R=301,L]
  RewriteRule ^privacy-policy/?$                 https://www.aria.srl/privacy.html [R=301,L]

  # --- Pagine EN ---
  RewriteRule ^en/contact/?$                     https://www.aria.srl/en/contact.html [R=301,L]
  RewriteRule ^en/projects/?$                    https://www.aria.srl/en/projects.html [R=301,L]
  RewriteRule ^en/publications/?$                https://www.aria.srl/en/publications.html [R=301,L]
  RewriteRule ^en/industrial-safety/?$           https://www.aria.srl/en/industrial-safety.html [R=301,L]
  RewriteRule ^en/workplaces/?$                  https://www.aria.srl/en/workplaces.html [R=301,L]
  RewriteRule ^en/management-systems/?$          https://www.aria.srl/en/management-systems.html [R=301,L]
  RewriteRule ^en/reliability-and-maintainability/?$ https://www.aria.srl/en/reliability-maintainability.html [R=301,L]
  RewriteRule ^en/education-training/?$          https://www.aria.srl/en/training.html [R=301,L]
  RewriteRule ^en/home-english/?$                https://www.aria.srl/en/ [R=301,L]

  # --- PDF (vecchi percorsi WordPress /wp-content/uploads -> /assets/docs) ---
  RewriteRule ^wp-content/uploads/2022/05/Aria-Srl_Brochure_ITA\.pdf$ https://www.aria.srl/assets/docs/Aria-Srl_Brochure_ITA.pdf [R=301,L]
  RewriteRule ^wp-content/uploads/2025/01/ISO-9001-CERT-16805-2005-AQ-TRI-SINCERT-3-it-IT-20231110-20231110080658-1\.pdf$ https://www.aria.srl/assets/docs/ISO-9001-Certificato-ARIA.pdf [R=301,L]

  # ==========================================================================
  #  Redirect canonico: HTTPS + www  (per tutto il resto)
  # ==========================================================================
  # Forza HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://www.aria.srl%{REQUEST_URI} [L,R=301]

  # Forza www
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.aria.srl%{REQUEST_URI} [L,R=301]
</IfModule>

# ----------------------------------------------------------------------------
#  1bis) Pagina d'ingresso: prima index.html (sito statico), poi index.php.
#        Rete di sicurezza nel caso restasse un index.php del vecchio WordPress.
# ----------------------------------------------------------------------------
<IfModule mod_dir.c>
  DirectoryIndex index.html index.htm index.php
</IfModule>

# ----------------------------------------------------------------------------
#  2) Security header — LIVELLO 1 (sicuri, attivi da subito)
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # --- HSTS: forza HTTPS lato browser per 1 anno. ATTIVO dal 2026-07-06.
  #     SENZA includeSubDomains, per non vincolare all'HTTPS eventuali sottodomini
  #     (es. webmail/ftp) non ancora pronti. Si potra aggiungere dopo averli verificati.
  #     Difficile da revocare in fretta: per annullare, rimettere max-age=0 e ricaricare.
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ----------------------------------------------------------------------------
#  3) Content-Security-Policy — LIVELLO 2 — ROLLOUT IN 2 TEMPI (dal 2026-07-06)
#     Policy validata via audit del sito (vedi docs/2026-07-06-hsts-csp-attivazione.md):
#     copre CSS/stili inline, main.js same-origin, font self-hosted, loghi locali,
#     mappa Google (frame-src www.google.com), JSON-LD.
#
#     FASE TEST (ATTIVA ORA): "Content-Security-Policy-Report-Only" → il browser NON
#       blocca nulla, segnala solo in console eventuali violazioni. Aprire tutte le
#       pagine (mappa, form, hover icone, hero animata, caroselli loghi, IT+EN) con la
#       console aperta e verificare che non compaiano avvisi CSP.
#     FASE ATTIVA (DOPO): confermato zero violazioni, COMMENTARE la riga Report-Only
#       qui sotto e DECOMMENTARE la riga Content-Security-Policy (blocco reale).
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
  # FASE TEST — solo report, non blocca:
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src https://www.google.com; connect-src 'self'; base-uri 'self'; form-action 'self' mailto:; object-src 'none'"

  # FASE ATTIVA — decommentare questa (e commentare la Report-Only sopra) quando confermato:
  # Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src https://www.google.com; connect-src 'self'; base-uri 'self'; form-action 'self' mailto:; object-src 'none'"
</IfModule>

# ----------------------------------------------------------------------------
#  4) Pagina di errore 404 personalizzata (se presente 404.html nella root)
# ----------------------------------------------------------------------------
ErrorDocument 404 /404.html
